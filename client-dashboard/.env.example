# Copy to .env.local and fill in. The anon/publishable key is safe to ship
# to the browser — every table this app touches is RLS-scoped by org
# (see ../supabase/migrations/20260908120100_foundation_rls.sql), not by
# hiding the key. This is the same Supabase project hub/ and dashboard-app/
# already point at (see supabase/README.md) — just a different, real-login,
# tenant-scoped app on top of it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GBP_OAUTH_START_URL=
VITE_GBP_LOCATIONS_CONNECT_URL=
