# Copy to .env.local and fill in. The anon/publishable key is safe to ship
# to the browser — it's constrained by RLS (see ../supabase/migrations),
# not a secret. Never put the service-role key here; writes go through
# admin-api instead (VITE_ADMIN_API_URL — the ADMIN_TOKEN itself is entered
# at runtime in the Settings gate, not baked into the build).
#
# Same Supabase project the standalone board/ app and admin.html/
# linkmaker.html already point at — see board/.env.example.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_API_URL=
